{
  "permissions": {
    "allow": [
      "Skill(update-config)",
      "Skill(update-config:*)",
      "Bash(jq --version)",
      "Bash(where jq *)",
      "Edit(/.claude/skills/output-format-guard/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"~\\.claude\\hooks\\check-secrets.ps1\"",
            "shell": "powershell",
            "timeout": 10,
            "statusMessage": "シークレット混入を確認中..."
          },
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"~\\.claude\\hooks\\check-diff-size.ps1\"",
            "shell": "powershell",
            "timeout": 10,
            "statusMessage": "差分行数を確認中..."
          }
        ]
      }
    ]
  }
}
